{
  "functions": {
    "api/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    {
      "src": "/api/buses",
      "dest": "/api/buses.js"
    },
    {
      "src": "/api/cron",
      "dest": "/api/cron.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/1 * * * *"
    }
  ]
}
